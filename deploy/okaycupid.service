[Unit]
Description=okaycupid web app
After=network.target

[Service]
Type=simple
User=okaycupid
Group=okaycupid
WorkingDirectory=/opt/okaycupid
EnvironmentFile=/etc/okaycupid/runtime.env
ExecStart=/usr/bin/node server/index.js
Restart=on-failure
RestartSec=5
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/okaycupid

[Install]
WantedBy=multi-user.target
